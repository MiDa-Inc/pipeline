diff --git a/retry.js b/retry.js
index 3df3447..db420d6 100644
--- a/retry.js
+++ b/retry.js
@@ -1,3 +1,12 @@
-export async function retry(fn, attempts) {
-  return fn();
+export async function retry(fn, attempts = 3, delayMs = 100) {
+  let lastError;
+  for (let i = 0; i < attempts; i++) {
+    try {
+      return await fn();
+    } catch (err) {
+      lastError = err;
+      if (i < attempts - 1) await new Promise((r) => setTimeout(r, delayMs * 2 ** i));
+    }
+  }
+  throw lastError;
 }
